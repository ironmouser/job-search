generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id                 String    @id @default(uuid()) @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  isCustomCareerPage Boolean   @default(false) @map("is_custom_career_page")
  addedById          String?   @map("added_by_id")
  title            String
  company          String
  location         String?
  salaryRange      String?   @map("salary_range")
  description      String?
  requirements     String?
  url              String    @unique
  applicationUrl   String?   @map("application_url")
  discoverySource  String?   @map("discovery_source")
  discoveryUrl     String?   @map("discovery_url")
  atsPlatform      String?   @map("ats_platform")
  atsJobId         String?   @map("ats_job_id")
  consecutiveAutoFailures Int @default(0) @map("consecutive_auto_failures")
  source           String?
  status           String    @default("discovered")
  appliedAt        DateTime? @map("applied_at") @db.Timestamptz(6)
  isArchived       Boolean   @default(false) @map("is_archived")
  isViewed         Boolean   @default(false) @map("is_viewed")
  isEasyApply      Boolean   @default(false) @map("is_easy_apply")

  userJobs          UserJob[]
  opportunityScores OpportunityScore[]
  applicationAssets ApplicationAsset[]
  jobFeedbacks      JobFeedback[]
  autoApplySessions AutoApplySession[]

  @@map("jobs")
}

model OpportunityScore {
  id                     String   @id @default(uuid()) @db.Uuid
  jobId                  String   @map("job_id") @db.Uuid
  userId                 String?  @map("user_id")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  totalScore             Int      @map("total_score")
  compensationScore      Int      @map("compensation_score")
  productFitScore        Int      @map("product_fit_score")
  remoteFlexibilityScore Int      @map("remote_flexibility_score")
  aiMaturityScore        Int      @map("ai_maturity_score")
  leadershipScore        Int      @map("leadership_score")
  growthScore            Int      @map("growth_score")
  cultureScore           Int      @map("culture_score")
  techStackScore         Int      @map("tech_stack_score")
  analysisNotes          String?  @map("analysis_notes")

  job  Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalScore(sort: Desc)])
  @@index([jobId])
  @@unique([userId, jobId])
  @@map("opportunity_scores")
}

model ApplicationAsset {
  id                     String   @id @default(uuid()) @db.Uuid
  jobId                  String   @map("job_id") @db.Uuid
  userId                 String?  @map("user_id")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tailoredResumeMarkdown String?  @map("tailored_resume_markdown")
  coverLetterMarkdown    String?  @map("cover_letter_markdown")
  networkingMessage      String?  @map("networking_message")
  portfolioRecommendation String? @map("portfolio_recommendation")
  previousTailoredResumeMarkdown String? @map("previous_tailored_resume_markdown")
  previousCoverLetterMarkdown    String? @map("previous_cover_letter_markdown")
  previousNetworkingMessage      String? @map("previous_networking_message")
  resumeRegensUsed            Int @default(0) @map("resume_regens_used")
  coverLetterRegensUsed       Int @default(0) @map("cover_letter_regens_used")
  networkingMessageRegensUsed Int @default(0) @map("networking_message_regens_used")
  qaGenerationsUsed           Int @default(0) @map("qa_generations_used")
  resumeDownloadsCount        Int @default(0) @map("resume_downloads_count")
  coverLetterDownloadsCount   Int @default(0) @map("cover_letter_downloads_count")

  job  Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@unique([userId, jobId])
  @@map("application_assets")
}

model JobFeedback {
  id           String   @id @default(uuid()) @db.Uuid
  jobId        String   @map("job_id") @db.Uuid
  userId       String?  @map("user_id")
  feedbackType String   @map("feedback_type") // 'like' or 'dislike'
  reasons      String[] @default([])
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  job  Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@unique([userId, jobId])
  @@map("job_feedback")
}

model SyncLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id")
  syncType     String   @map("sync_type")
  lastSyncedAt DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@unique([userId, syncType])
  @@map("sync_logs")
}

model ScraperLog {
  id             String   @id @default(uuid()) @db.Uuid
  scraperName    String   @map("scraper_name")
  targetUrl      String?  @map("target_url")
  status         String   // 'SUCCESS', 'FAILURE', 'PARTIAL'
  resultsCount   Int      @default(0) @map("results_count")
  errorDetails   String?  @map("error_details")
  usedFirecrawl  Boolean  @default(false) @map("used_firecrawl")
  firecrawlSites String[] @default([]) @map("firecrawl_sites")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@map("scraper_logs")
}

// NextAuth Models

enum Role {
  USER
  ORGANIZATION_ADMIN
  SYSTEM_ADMIN
}

enum SubscriptionType {
  FREE
  PREMIUM
  GROUP
}

enum OrganizationType {
  BUSINESS
  CAREER_CENTER
  NONPROFIT
  STAFFING_AGENCY
  EDUCATIONAL_INSTITUTION
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// ─── Organization Models ──────────────────────────────────────────────────────

model Organization {
  id                     String           @id @default(uuid()) @db.Uuid
  name                   String
  organizationType       OrganizationType @map("organization_type")
  stripeCustomerId       String?          @unique @map("stripe_customer_id")
  stripeSubscriptionId   String?          @unique @map("stripe_subscription_id")
  stripePriceId          String?          @map("stripe_price_id")
  stripeCurrentPeriodEnd DateTime?        @map("stripe_current_period_end") @db.Timestamptz(6)
  seatCount              Int              @default(0) @map("seat_count")
  consumedSeats          Int              @default(0) @map("consumed_seats")
  seatValidityDays       Int              @default(90) @map("seat_validity_days")
  createdBy              String           @map("created_by")
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  users        User[]
  invitations  OrganizationInvitation[]
  activityLogs OrganizationActivityLog[]

  @@map("organizations")
}

model OrganizationInvitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String
  invitedBy      String           @map("invited_by")
  token          String           @unique @default(uuid())
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email, status])
  @@index([organizationId])
  @@map("organization_invitations")
}

model OrganizationActivityLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String   @map("actor_id")
  action         String
  targetId       String?  @map("target_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("organization_activity_logs")
}

model GlobalSettings {
  id                    String  @id @default("system")
  // Scrapers - Company Career Sites (ATS)
  greenhouseIsPro       Boolean @default(false) @map("greenhouse_is_pro")
  leverIsPro            Boolean @default(true) @map("lever_is_pro")
  ashbyIsPro            Boolean @default(true) @map("ashby_is_pro")
  workableIsPro         Boolean @default(true) @map("workable_is_pro")
  smartrecruitersIsPro  Boolean @default(true) @map("smartrecruiters_is_pro")
  breezyIsPro           Boolean @default(true) @map("breezy_is_pro")
  workdayIsPro          Boolean @default(true) @map("workday_is_pro")
  taleoIsPro            Boolean @default(true) @map("taleo_is_pro")
  icimsIsPro            Boolean @default(true) @map("icims_is_pro")

  // Scrapers - Global Job Boards
  linkedinIsPro         Boolean @default(false) @map("linkedin_is_pro")
  indeedIsPro           Boolean @default(true) @map("indeed_is_pro")
  glassdoorIsPro        Boolean @default(true) @map("glassdoor_is_pro")
  ziprecruiterIsPro     Boolean @default(true) @map("ziprecruiter_is_pro")
  diceIsPro             Boolean @default(true) @map("dice_is_pro")

  // Scrapers - Remote & Tech Aggregators
  weworkremotelyIsPro   Boolean @default(true) @map("weworkremotely_is_pro")
  remoteokIsPro         Boolean @default(true) @map("remoteok_is_pro")
  workingnomadsIsPro    Boolean @default(true) @map("workingnomads_is_pro")
  remotiveIsPro         Boolean @default(false) @map("remotive_is_pro")
  remotepocIsPro        Boolean @default(false) @map("remotepoc_is_pro")
  ycombinatorIsPro      Boolean @default(true) @map("ycombinator_is_pro")
  nodeskIsPro           Boolean @default(false) @map("nodesk_is_pro")
  ottaIsPro             Boolean @default(true) @map("otta_is_pro")
  himalayasIsPro        Boolean @default(true) @map("himalayas_is_pro")

  // Scrapers - International Job Boards
  arbeitnowIsPro        Boolean @default(true) @map("arbeitnow_is_pro")
  themuseIsPro          Boolean @default(true) @map("themuse_is_pro")
  computrabajoIsPro     Boolean @default(true) @map("computrabajo_is_pro")
  jobbankIsPro          Boolean @default(true) @map("jobbank_is_pro")

  // Email Sync
  emailsSyncIsPro       Boolean @default(true) @map("emails_sync_is_pro")
  // AI Features
  aiOpportunityScoringIsPro Boolean @default(true) @map("ai_opportunity_scoring_is_pro")
  aiAssetGenerationIsPro    Boolean @default(true) @map("ai_asset_generation_is_pro")
  aiQaHelperIsPro           Boolean @default(true) @map("ai_qa_helper_is_pro")
  autoApplyIsPro            Boolean @default(true) @map("auto_apply_is_pro")

  // Recruiter Network Feature Flags
  recruiterNetworkEnabled   Boolean @default(false) @map("recruiter_network_enabled")
  recruiterPortalEnabled    Boolean @default(false) @map("recruiter_portal_enabled")
  recruiterDiscoveryEnabled Boolean @default(false) @map("recruiter_discovery_enabled")

  @@map("global_settings")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)

  // Organization membership
  organizationId   String?          @map("organization_id") @db.Uuid
  subscriptionType      SubscriptionType? @map("subscription_type")
  isDisabled            Boolean?          @default(false) @map("is_disabled")
  orgAccessExpiresAt    DateTime?         @map("org_access_expires_at") @db.Timestamptz(6)

  // Stripe & Subscriptions (personal users only; org users have billing on Organization)
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  trialEndsAt            DateTime?
  planTier               String    @default("FREE")
  isOnboarded            Boolean   @default(false) @map("is_onboarded")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt            DateTime? @map("last_login_at") @db.Timestamptz(6)

  // Anti-abuse & Multi-account tracking
  normalizedEmail      String?   @map("normalized_email")
  isTrialDeferred      Boolean   @default(false) @map("is_trial_deferred")
  trialDeferralReason  String?   @map("trial_deferral_reason")
  primaryUserId        String?   @map("primary_user_id")
  unifiedQuotaGroupId  String?   @map("unified_quota_group_id")

  // Device telemetry tracking
  regDeviceType        String?   @map("reg_device_type")
  deviceLastUsed       String?   @map("device_last_used")
  lastUserAgent        String?   @map("last_user_agent")
  resumeDownloadsCount Int       @default(0) @map("resume_downloads_count")
  coverLetterDownloadsCount Int  @default(0) @map("cover_letter_downloads_count")

  accounts      Account[]
  sessions      Session[]
  
  organization         Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userPreferences      UserPreferences?
  userJobs             UserJob[]
  scores               OpportunityScore[]
  assets               ApplicationAsset[]
  feedbacks            JobFeedback[]
  appFeedbacks         AppFeedback[]
  autoApplySessions    AutoApplySession[]
  interventionRequests InterventionRequest[]
  deviceVerifications  DeviceVerification[]
  collisionLogsTarget  AccountCollisionLog[]   @relation("CollisionTarget")
  collisionLogsPrimary AccountCollisionLog[]   @relation("CollisionPrimary")
  upgradeEvents        UpgradeEvent[]
  connectedJobBoards   ConnectedJobBoard[]

  // Recruiter Network Relations
  recruiterProfile       RecruiterProfile?
  candidateConsents      CandidateConsent[]        @relation("CandidateConsents")
  consentEvents          ConsentEvent[]            @relation("CandidateConsentEvents")
  intentSnapshots        CandidateIntentSnapshot[] @relation("CandidateIntentSnapshots")
  recruiterMatches       RecruiterJobMatch[]       @relation("CandidateMatches")
  candidateIntroductions Introduction[]            @relation("CandidateIntroductions")
  candidatePlacements    PlacementEvent[]          @relation("CandidatePlacements")
}


model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserPreferences {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  searchKeyword     String?
  jobLevel          String?  @default("Mid-level") @map("job_level")
  searchLocation    String?
  includeKeywords   String?  @map("include_keywords")
  excludeKeywords   String?  @map("exclude_keywords")
  customCareerPages String[] @default([])
  sources           Json?    @default("{}")
  remoteOnly        Boolean  @default(false)
  noInternational   Boolean  @default(false) @map("no_international")
  hasSeenNonUsPrompt Boolean @default(false) @map("has_seen_non_us_prompt")
  theme             String   @default("light")
  aiStrictness      String   @default("Standard")
  coverLetterTone       String?  @default("Confident and strategic") @map("cover_letter_tone")
  networkingMessageTone String?  @default("Confident and strategic") @map("networking_message_tone")
  resumeCustomizationMaxPercentage Int @default(50)
  resumeMarkdown    String?  @db.Text
  profile           String?  @db.Text
  emailAddress      String?
  emailAppPassword  String?
  imapHost          String?  @default("imap.gmail.com")
  imapPort          Int?     @default(993)
  // Contact & Personal Info
  phone             String?
  location          String?
  streetAddress     String?  @map("street_address")
  city              String?
  state             String?
  postalCode        String?  @map("postal_code")
  linkedinUrl       String?  @map("linkedin_url")
  githubUrl         String?  @map("github_url")
  websiteUrl        String?  @map("website_url")

  // Authorization / Auto Apply Settings
  usWorkAuthorization String? @map("us_work_authorization")
  workingRemotelyFrom String? @map("working_remotely_from")
  visaSponsorship     String? @map("visa_sponsorship")
  country             String?
  eeocRace            String? @map("eeoc_race")
  eeocGender          String? @map("eeoc_gender")
  eeocVeteran         String? @map("eeoc_veteran")
  eeocDisability      String? @map("eeoc_disability")
  skipSelfId          Boolean @default(false) @map("skip_self_id")
  startDate           String? @map("start_date")
  expectedSalary      String? @map("expected_salary")
  willingToTravel     String? @map("willing_to_travel")
  isOver18            String? @map("is_over_18")
  willingToRelocate   String? @map("willing_to_relocate")
  defaultAccountPassword String? @map("default_account_password")
  autoApplyMode          String? @default("autopilot") @map("auto_apply_mode")
  maxConcurrentAutoApplies Int?   @default(3) @map("max_concurrent_auto_applies")

  // PDF Styling Customization
  resumePdfTemplate         String? @default("classic") @map("resume_pdf_template")
  resumePdfFontFamily       String? @default("Helvetica, Arial, sans-serif") @map("resume_pdf_font_family")
  resumePdfFontSize         String? @default("11pt") @map("resume_pdf_font_size")
  resumePdfLineHeight       String? @default("1.5") @map("resume_pdf_line_height")
  resumePdfPrimaryColor     String? @default("#1e3a8a") @map("resume_pdf_primary_color")
  resumePdfTextColor        String? @default("#111827") @map("resume_pdf_text_color")
  resumePdfMargin           String? @default("0.5in") @map("resume_pdf_margin")
  resumePdfHeaderLayout     String? @default("left") @map("resume_pdf_header_layout")

  coverLetterPdfTemplate     String? @default("classic") @map("cover_letter_pdf_template")
  coverLetterPdfFontFamily   String? @default("Helvetica, Arial, sans-serif") @map("cover_letter_pdf_font_family")
  coverLetterPdfFontSize     String? @default("11pt") @map("cover_letter_pdf_font_size")
  coverLetterPdfLineHeight   String? @default("1.5") @map("cover_letter_pdf_line_height")
  coverLetterPdfPrimaryColor String? @default("#1e3a8a") @map("cover_letter_pdf_primary_color")
  coverLetterPdfTextColor    String? @default("#111827") @map("cover_letter_pdf_text_color")
  coverLetterPdfMargin       String? @default("0.5in") @map("cover_letter_pdf_margin")
  coverLetterPdfHeaderLayout String? @default("left") @map("cover_letter_pdf_header_layout")

  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserJob {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  jobId      String    @map("job_id") @db.Uuid
  status     String    @default("discovered")
  appliedAt  DateTime? @map("applied_at") @db.Timestamptz(6)
  viewedAt   DateTime? @map("viewed_at") @db.Timestamptz(6)
  ipAddress  String?   @map("ip_address")
  isArchived Boolean   @default(false) @map("is_archived")
  isPrivate Boolean   @default(false) @map("is_private")
  unlockedBySubmission Boolean @default(false) @map("unlocked_by_submission")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, viewedAt])
  @@map("user_jobs")
}

model ScrapeCache {
  id        String   @id @default(cuid())
  source    String   
  keyword   String   @default("")
  location  String   @default("")
  rawJobs   Json     @default("[]")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  
  @@unique([source, keyword, location])
  @@index([expiresAt])
  @@map("scrape_cache")
}

// ─── Auto Apply Models ──────────────────────────────────────────────────────

model AutoApplySession {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id")
  jobId                String    @map("job_id") @db.Uuid
  status               String    @default("queued")   // AutoApplyStatus enum value
  atsPlatform          String?   @map("ats_platform")  // ATSPlatform enum value
  atsConfidence        Int?      @map("ats_confidence")
  automationConfidence Int?      @map("automation_confidence")
  simulationMode       Boolean   @default(true) @map("simulation_mode")

  // Failure tracking
  failureReason        String?   @map("failure_reason")
  failureDetails       String?   @map("failure_details") @db.Text
  retryCount           Int       @default(0) @map("retry_count")
  maxRetries           Int       @default(3) @map("max_retries")

  // Browser session metadata (viewport, userAgent, etc.)
  browserSessionId     String?   @map("browser_session_id")
  browserMetadata      Json?     @map("browser_metadata")

  // Workflow state
  currentStep          String?   @map("current_step")
  stepsCompleted       Int       @default(0) @map("steps_completed")
  stepsTotal           Int?      @map("steps_total")

  // Submission Proof & Receipt
  confirmationScreenshotUrl String?   @map("confirmation_screenshot_url")
  confirmationNumber        String?   @map("confirmation_number")
  submittedAnswersSummary   Json?     @map("submitted_answers_summary")

  // Which worker instance is handling this
  workerId             String?   @map("worker_id")

  // Timestamps
  startedAt            DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  executionLogs ExecutionLog[]
  interventions InterventionRequest[]

  @@index([userId, status])
  @@index([jobId])
  @@index([status, createdAt])   // Used by worker queue polling
  @@index([createdAt(sort: Desc)])
  @@map("auto_apply_sessions")
}

model ExecutionLog {
  id             String   @id @default(uuid()) @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  timestamp      DateTime @default(now()) @db.Timestamptz(6)
  level          String   // 'info' | 'warn' | 'error' | 'debug'
  step           String   // Standardized step key e.g. 'browser_launched'
  message        String
  metadata       Json?    // Non-PII structured data
  durationMs     Int?     @map("duration_ms")
  screenshotPath String?  @map("screenshot_path")

  session AutoApplySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
  @@map("execution_logs")
}

model InterventionRequest {
  id            String    @id @default(uuid()) @db.Uuid
  sessionId     String    @map("session_id") @db.Uuid
  userId        String    @map("user_id")
  jobId         String    @map("job_id") @db.Uuid
  reason        String    // InterventionReason enum value
  description   String
  screenshotUrl String?   @map("screenshot_url")
  pageUrl       String?   @map("page_url")
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolution    String?   // 'completed' | 'skipped' | 'cancelled'
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session AutoApplySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, resolvedAt])
  @@index([sessionId])
  @@map("intervention_requests")
}

model ATSPlatformProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  platform            String   @unique  // ATSPlatform enum value
  displayName         String   @map("display_name")
  automationSupported Boolean  @default(false) @map("automation_supported")
  detectionSignatures Json     @default("{}") @map("detection_signatures")
  successRate         Float    @default(0) @map("success_rate")    // Rolling average
  totalAttempts       Int      @default(0) @map("total_attempts")
  totalSuccesses      Int      @default(0) @map("total_successes")
  notes               String?
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("ats_platform_profiles")
}

model SystemAlert {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   // e.g., 'HIGH_COST_BLOCKED'
  message     String
  metadata    Json?    // Store cost estimates, model type, user ID
  isResolved  Boolean  @default(false) @map("is_resolved")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("system_alerts")
}

model AICostLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id")
  model       String
  inputTokens Int      @map("input_tokens")
  outputTokens Int     @map("output_tokens")
  costUsd     Float    @map("cost_usd")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("ai_cost_logs")
}

model AppFeedback {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String?  @map("user_id")
  userName            String   @map("user_name")
  planType            String   @map("plan_type")
  jobTitle            String   @map("job_title")
  rating              Int
  totalJobsApplied    Int      @map("total_jobs_applied")
  totalJobsDiscovered Int      @map("total_jobs_discovered")
  totalSyncedEmails   Int      @map("total_synced_emails")
  comment             String   @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("app_feedback")
}

model DeviceVerification {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  deviceFingerprint String   @map("device_fingerprint")
  deviceType        String   @default("mobile") @map("device_type")
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  cookieConsent     Boolean  @default(true) @map("cookie_consent")
  verifiedAt        DateTime @default(now()) @map("verified_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceFingerprint])
  @@index([userId])
  @@map("device_verifications")
}

model AccountCollisionLog {
  id            String   @id @default(uuid()) @db.Uuid
  targetUserId  String   @map("target_user_id")
  primaryUserId String?  @map("primary_user_id")
  signalType    String   @map("signal_type") // 'NORMALIZED_EMAIL', 'PHONE_MATCH', 'LINKEDIN_MATCH', 'RESUME_WORK_HISTORY', 'MOBILE_FINGERPRINT'
  details       Json?
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  targetUser  User  @relation("CollisionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  primaryUser User? @relation("CollisionPrimary", fields: [primaryUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId])
  @@index([primaryUserId])
  @@index([createdAt(sort: Desc)])
  @@map("account_collision_logs")
}

model QRSessionToken {
  id           String    @id @default(uuid()) @db.Uuid
  token        String    @unique
  userId       String    @map("user_id")
  status       String    @default("pending") // 'pending', 'verified', 'rejected', 'expired'
  verifiedByIp String?   @map("verified_by_ip")
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([token])
  @@index([userId])
  @@map("qr_session_tokens")
}

model UpgradeEvent {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id")
  status           String    @default("ATTEMPTED") // 'ATTEMPTED', 'SUCCEEDED', 'FAILED', 'CANCELLED'
  priceId          String?   @map("price_id")
  stripeSessionId  String?   @map("stripe_session_id")
  stripeCustomerId String?   @map("stripe_customer_id")
  planTier         String    @default("PRO") @map("plan_tier")
  amount           Int?
  currency         String?   @default("usd")
  failureReason    String?   @map("failure_reason")
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

